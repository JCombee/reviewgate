{
  "name": "reviewgate-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/cli",
    "clean": "tsc -b --clean packages/core packages/cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit packages/core packages/cli"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
