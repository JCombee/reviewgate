{
  "name": "reviewgate-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:ts && npm run build:web",
    "build:ts": "tsc -b packages/core packages/server packages/cli",
    "build:web": "npm run build --workspace @reviewgate/web",
    "clean": "tsc -b --clean packages/core packages/server packages/cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit packages/core packages/server packages/cli && npm run typecheck --workspace @reviewgate/web",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:all": "npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "packages/*"
  ]
}
