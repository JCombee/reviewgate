{
  "name": "reviewgate-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:web",
    "build:ts": "tsc -b packages/core packages/server packages/cli",
    "build:web": "pnpm --filter @reviewgate/web build",
    "clean": "tsc -b --clean packages/core packages/server packages/cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit packages/core packages/server packages/cli && pnpm --filter @reviewgate/web typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
